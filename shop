class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.startswith("/state.json"):
            body, ctype = json.dumps(load_db()).encode(), "application/json"
        else:
            body, ctype = PAGE.encode(), "text/html; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_):
        pass


def cmd_serve(args):
    port = int(arg(args, "--port", "8099"))
    print(f"Ledger page: http://localhost:{port}  (Ctrl-C to stop)")
    HTTPServer(("127.0.0.1", port), Handler).serve_forever()


COMMANDS = {
    "search": cmd_search, "add": cmd_add, "cart": cmd_cart, "checkout": cmd_checkout,
    "pay": cmd_pay, "order-status": cmd_order_status, "ledger": cmd_ledger,
    "reset": cmd_reset, "serve": cmd_serve,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        sys.exit(0)
    fn = COMMANDS.get(sys.argv[1])
    if not fn:
        die(f"Unknown command: {sys.argv[1]}. Try --help")
    fn(sys.argv[2:])
